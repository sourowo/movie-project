# =====================================================
# .gitignore
# 寫在這裡的檔案 / 資料夾，Git 都會當作沒看到，
# 不會被記錄、不會被上傳。
# 開頭是 # 的行是註解，Git 會忽略。
# =====================================================


# -----------------------------------------------------
# PyInstaller 打包產出物
# 這些都是從原始碼「產生」出來的，隨時可以重做，
# 而且體積很大（你的 _internal 資料夾就有 30MB）。
# -----------------------------------------------------

build/
dist/
_internal/
*.exe
*.pkg


# -----------------------------------------------------
# 場次資料
# 每天都會變，如果讓 Git 記錄，每天就多存一份 3MB。
# 程式會自己重新抓，不需要存進版本紀錄。
# -----------------------------------------------------

showtimes.json
showtimes_normalized.json
showtimes_backup_*.json


# -----------------------------------------------------
# Python 執行時自動產生的暫存檔
# 你不會手動去開它們，也完全不需要備份。
# -----------------------------------------------------

__pycache__/
*.pyc
*.pyo

# 虛擬環境（如果之後有用到的話）
venv/
.venv/
env/


# -----------------------------------------------------
# 編輯器 / 作業系統的雜物
# -----------------------------------------------------

.vscode/
.idea/
Thumbs.db
desktop.ini
.DS_Store


# -----------------------------------------------------
# 密碼、金鑰之類的東西
# 現在用不到，但先寫著。
# 以後如果串 Google Calendar API 會需要，
# 這種檔案「絕對」不能進 Git。
# -----------------------------------------------------

.env
*.key
credentials.json
token.json
showtimes.json
